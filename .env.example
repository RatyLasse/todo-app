# Get an OpenRouter API key at https://openrouter.ai/settings/keys.
# Optional: leave empty to use editable Medium / Other fallback suggestions.
# Keep the real key in .env or a server environment variable, never frontend code.
OPENROUTER_API_KEY=
# Free model variant with structured output support.
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# Relative to the directory from which you start the backend.
TODO_DATABASE_PATH=data/tasks.sqlite3
